{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolution-engine.org/schemas/20_reproducibility_certificate.schema.json",
  "title": "ReproducibilityCertificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate_id",
    "run_id",
    "reproducibility_level",
    "master_seed",
    "replay_match_ratio",
    "verified_at"
  ],
  "properties": {
    "certificate_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "reproducibility_level": {
      "type": "string",
      "enum": ["R0_NONE", "R1_LOGICAL_FSM", "R2_STATISTICAL", "R3_DETERMINISTIC_SUBSET", "R4_BIT_IDENTICAL"]
    },
    "master_seed": {
      "type": "integer",
      "minimum": 0
    },
    "replay_match_ratio": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{6}$"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
