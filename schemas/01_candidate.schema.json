{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolution-engine.org/schemas/01_candidate.schema.json",
  "title": "CandidateManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "generation_id",
    "source_hash",
    "parent_candidate_id",
    "mutation_id",
    "lifecycle_state",
    "created_at"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "format": "uuid"
    },
    "generation_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_candidate_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "mutation_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "lifecycle_state": {
      "$ref": "02_candidate_state.schema.json"
    },
    "ast_delta_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes_added": { "type": "integer", "minimum": 0 },
        "nodes_removed": { "type": "integer", "minimum": 0 },
        "nodes_modified": { "type": "integer", "minimum": 0 },
        "tree_edit_distance": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$" }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
