{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolution-engine.org/schemas/26_engine_config.schema.json",
  "title": "EngineConfig",
  "description": "Canonical evolution.yaml. Derived from Active Contract section 5.3; that section and this schema must never diverge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "evolution",
    "metrics",
    "selection",
    "sandbox",
    "deployment",
    "stopping"
  ],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "language"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "population_size",
        "seed"
      ],
      "properties": {
        "level": {
          "enum": [
            "function",
            "module",
            "project"
          ]
        },
        "population_size": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "direction",
          "unit",
          "valid_range",
          "practical_margin_decimal",
          "failure_policy",
          "preference_weight_decimal",
          "command"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "maximize",
              "minimize"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "valid_range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimum_decimal",
              "maximum_decimal"
            ],
            "properties": {
              "minimum_decimal": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                "description": "Canonical decimal string (REQ-S05-011). Never a binary float."
              },
              "maximum_decimal": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                "description": "Canonical decimal string (REQ-S05-011). Never a binary float."
              }
            }
          },
          "practical_margin_decimal": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "description": "Canonical decimal string (REQ-S05-011). Never a binary float."
          },
          "failure_policy": {
            "type": "string",
            "minLength": 1,
            "description": "Domain not yet fixed by the Active Contract; section 5.3 shows invalidate_candidate."
          },
          "preference_weight_decimal": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "description": "Canonical decimal string (REQ-S05-011). Never a binary float."
          },
          "command": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "argv",
              "cwd",
              "env",
              "timeout_seconds"
            ],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "argv-only; no shell (REQ-S05-001)"
              },
              "cwd": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "timeout_seconds": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "preference_weights_usage",
        "tie_break_order"
      ],
      "properties": {
        "method": {
          "enum": [
            "pareto"
          ]
        },
        "preference_weights_usage": {
          "type": "string",
          "minLength": 1,
          "description": "Domain not yet fixed; section 5.3 shows same_front_tie_break_only."
        },
        "tie_break_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Ordered and total (REQ-S10-010)."
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability_commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "argv",
              "cwd",
              "env",
              "timeout_seconds"
            ],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "argv-only; no shell (REQ-S05-001)"
              },
              "cwd": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "timeout_seconds": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "network",
        "writable_tmp_bytes"
      ],
      "properties": {
        "profile": {
          "enum": [
            "PROFILE_A_LINUX"
          ]
        },
        "network": {
          "enum": [
            "deny",
            "allow"
          ]
        },
        "writable_tmp_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "SAFE_EXPORT_ONLY",
            "GOVERNED_CANARY",
            "PRODUCTION_ACTIVE",
            "SELF_EVOLUTION_SANDBOX"
          ],
          "default": "SAFE_EXPORT_ONLY"
        }
      }
    },
    "stopping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_generations",
        "max_stagnation",
        "max_runtime_seconds",
        "target_rule"
      ],
      "properties": {
        "target_rule": {
          "type": [
            "string",
            "null"
          ],
          "description": "Domain not yet fixed; null means no target rule."
        },
        "max_generations": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "max_stagnation": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "max_runtime_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
