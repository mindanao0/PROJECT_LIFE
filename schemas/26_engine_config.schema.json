{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolution-engine.org/schemas/26_engine_config.schema.json",
  "title": "EvolutionEngineConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project",
    "evolution",
    "selection",
    "sandbox"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["10.2.2"]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "language", "source_root"],
      "properties": {
        "name": { "type": "string" },
        "language": { "type": "string" },
        "source_root": { "type": "string" }
      }
    },
    "evolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population_size", "max_generations", "master_seed"],
      "properties": {
        "population_size": { "type": "integer", "minimum": 4, "maximum": 1000 },
        "max_generations": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "master_seed": { "type": "integer", "minimum": 0 },
        "stagnation_limit": { "type": "integer", "minimum": 1 }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectives", "preference_weights"],
      "properties": {
        "objectives": {
          "type": "array",
          "items": { "type": "string" }
        },
        "preference_weights": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$" }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "timeout_seconds", "memory_limit_mb"],
      "properties": {
        "profile": { "type": "string", "enum": ["PROFILE_A_LINUX", "PROFILE_B_CONTAINER"] },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "memory_limit_mb": { "type": "integer", "minimum": 64, "maximum": 4096 },
        "max_pids": { "type": "integer", "minimum": 8, "maximum": 512 }
      }
    }
  }
}
