{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolution-engine.org/schemas/17_selection_decision.schema.json",
  "title": "SelectionDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "generation_id",
    "candidate_id",
    "decision",
    "rank_index",
    "crowding_distance_decimal"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "generation_id": {
      "type": "string",
      "format": "uuid"
    },
    "candidate_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision": {
      "type": "string",
      "enum": ["SELECTED_ELITE", "SELECTED_DIVERSE", "REJECTED_DOMINATED", "QUARANTINED"]
    },
    "rank_index": {
      "type": "integer",
      "minimum": 1
    },
    "crowding_distance_decimal": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{6}$"
    }
  }
}
