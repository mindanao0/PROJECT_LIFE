{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolution-engine.org/schemas/08_baseline.schema.json",
  "title": "BaselineMeasurement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline_id",
    "project_id",
    "source_hash",
    "metric_measurements",
    "measured_at"
  ],
  "properties": {
    "baseline_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metric_measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objective_name", "mean_decimal", "std_dev_decimal", "samples_count"],
        "properties": {
          "objective_name": { "type": "string" },
          "mean_decimal": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{6}$" },
          "std_dev_decimal": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$" },
          "samples_count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "measured_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
